{
  "openapi": "3.0.3",
  "info": {
    "title": "Activity Sources",
    "description": "An activity source tells where an activity came from: a client, an appointment, a payment, an invoice, a document, a review or a cart. Create a source, then store its `uid` on the activity it describes.\n\nThe `uid` parameters also accept the legacy numeric identifier of a source.",
    "version": "3.0.0",
    "contact": {}
  },
  "servers": [
    {
      "url": "https://api.vcita.biz",
      "description": "API Gateway server"
    }
  ],
  "tags": [
    {
      "name": "Activity Source",
      "description": "Where an activity came from."
    }
  ],
  "paths": {
    "/v3/clients/activity_sources": {
      "get": {
        "summary": "Get all ActivitySources",
        "description": "## Overview\nGet the activity sources of the business, with pagination.\n\nWith `uid`, get the listed sources in one call, with no pagination. Use it to get the sources of a page of activities.\n\nAvailable for **Staff Tokens**.",
        "parameters": [
          {
            "name": "uid",
            "in": "query",
            "required": false,
            "description": "Activity source identifiers, as a comma list (`uid=a1,a2`). At most 500.",
            "schema": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": false,
            "example": [
              "3rizqwm5l4ygffdu",
              "k2m9x7q1w5e8r4tz"
            ]
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number of results. Ignored with `uid`.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "How many items to return per page. Max: 100. Ignored with `uid`.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort by fields. Example: sort=created_at:desc. Supported: created_at:asc, created_at:desc.",
            "schema": {
              "type": "string",
              "default": "created_at:desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "$ref": "#/components/schemas/ActivitySourcesList"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Activity Source"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      },
      "post": {
        "summary": "Create an ActivitySource",
        "description": "## Overview\nCreate an activity source for the business. Store its `uid` on the activity it describes.\n\n`utm_params` is stored only for businesses with the sales account feature.\n\nAvailable for **Staff Tokens**.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivitySourceCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "https://vcita.github.io/developers-hub/entities/clients/activity_source.json"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Activity Source"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v3/clients/activity_sources/{uid}": {
      "get": {
        "summary": "Retrieve an ActivitySource",
        "description": "## Overview\nRetrieve one activity source of the business by its unique identifier (UID).\n\nAvailable for **Staff Tokens**.",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "description": "The unique identifier of the activity source.",
            "schema": {
              "type": "string"
            },
            "example": "3rizqwm5l4ygffdu"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "https://vcita.github.io/developers-hub/entities/clients/activity_source.json"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Activity source not found in this business",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Activity Source"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "The token is missing or may not use this endpoint",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ActivitySourcesList": {
        "type": "object",
        "properties": {
          "activity_sources": {
            "description": "List of ActivitySources",
            "type": "array",
            "items": {
              "$ref": "https://vcita.github.io/developers-hub/entities/clients/activity_source.json"
            }
          }
        }
      },
      "ActivitySourceCreateRequest": {
        "type": "object",
        "description": "The fields of the new activity source. Every field is optional.",
        "properties": {
          "source_name": {
            "type": "string",
            "nullable": true,
            "maxLength": 255,
            "description": "The name of the source the activity came from. See `source_name` in the ActivitySource entity for the known values.",
            "example": "website"
          },
          "source_channel": {
            "type": "string",
            "nullable": true,
            "maxLength": 255,
            "description": "The channel inside the source, for example the widget or the medium. See `source_channel` in the ActivitySource entity.",
            "example": "scheduler_widget"
          },
          "source_campaign": {
            "type": "string",
            "nullable": true,
            "maxLength": 255,
            "description": "The campaign of the source, in the UTM sense: the label of what sent the link. See `source_campaign` in the ActivitySource entity.",
            "example": null
          },
          "source_url": {
            "type": "string",
            "nullable": true,
            "description": "The page where the activity started. Longer values are cut to 255 characters.",
            "example": "https://www.example.com/book"
          },
          "utm_params": {
            "type": "object",
            "nullable": true,
            "description": "The marketing parameters of the visit: the five UTM parameters and `gclid`. Stored only for businesses with the sales account feature.",
            "properties": {
              "utm_source": {
                "type": "string",
                "nullable": true,
                "maxLength": 255,
                "description": "The UTM source, for example `adwords`."
              },
              "utm_medium": {
                "type": "string",
                "nullable": true,
                "maxLength": 255,
                "description": "The UTM medium, for example `ppc`."
              },
              "utm_campaign": {
                "type": "string",
                "nullable": true,
                "maxLength": 255,
                "description": "The UTM campaign."
              },
              "utm_term": {
                "type": "string",
                "nullable": true,
                "maxLength": 255,
                "description": "The UTM term."
              },
              "utm_content": {
                "type": "string",
                "nullable": true,
                "maxLength": 255,
                "description": "The UTM content."
              },
              "gclid": {
                "type": "string",
                "nullable": true,
                "maxLength": 255,
                "description": "The Google Ads click identifier."
              }
            },
            "example": null
          }
        },
        "example": {
          "source_name": "website",
          "source_channel": "scheduler_widget",
          "source_url": "https://www.example.com/book"
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Provide a valid bearer token in the Authorization header. Example: 'Authorization: Bearer {token}'"
      }
    }
  }
}
