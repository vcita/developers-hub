{
  "openapi": "3.0.3",
  "info": {
    "title": "Activity Sources",
    "description": "An ActivitySource tells where an activity came from, for example a client, an appointment or a payment. Any entity can reference an ActivitySource.",
    "version": "3.0.0",
    "contact": {}
  },
  "servers": [
    {
      "url": "https://api.vcita.biz",
      "description": "API Gateway server"
    }
  ],
  "tags": [
    {
      "name": "Activity Source",
      "description": "Where an activity came from."
    }
  ],
  "paths": {
    "/v3/clients/activity_sources": {
      "get": {
        "operationId": "listActivitySources",
        "summary": "Get all ActivitySources",
        "description": "## Overview\nGet the ActivitySources of the business, with pagination.\n\nWith `uid`, get only the listed sources (at most 100). Use it to get the sources of a page of activities: send `per_page=100` to get every match on one page.\n\nAvailable for **Staff Tokens**.",
        "parameters": [
          {
            "name": "uid",
            "in": "query",
            "required": false,
            "description": "ActivitySource unique identifiers, as a comma list (`uid=a1,a2`). At most 100. The result is paginated like the rest of the list: send `per_page=100` to get every match on one page.",
            "schema": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": false,
            "example": [
              "3rizqwm5l4ygffdu",
              "k2m9x7q1w5e8r4tz"
            ]
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number of results.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "How many items to return per page. Max: 100.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort by creation time (e.g., \"created_at:desc\", \"created_at:asc\").",
            "schema": {
              "type": "string",
              "enum": [
                "created_at:desc",
                "created_at:asc"
              ],
              "default": "created_at:desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "$ref": "#/components/schemas/ActivitySourcesList"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "success": true,
                  "data": {
                    "activity_sources": [
                      {
                        "uid": "3rizqwm5l4ygffdu",
                        "business_uid": "d3f8a1k9p2m7x4qz",
                        "source_name": "website",
                        "source_channel": "scheduler_widget",
                        "source_campaign": null,
                        "source_url": "https://www.example.com/book",
                        "utm_params": null,
                        "created_at": "2026-10-30T07:32:31Z",
                        "updated_at": "2026-10-30T07:32:31Z"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "errors": [
                    {
                      "field": "uid",
                      "code": "invalid",
                      "message": "uid accepts at most 100 values"
                    }
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "Activity Source"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      },
      "post": {
        "operationId": "createActivitySource",
        "summary": "Create an ActivitySource",
        "description": "## Overview\nCreate an ActivitySource for the business.\n\n`utm_params` is stored only for businesses with the sales account feature.\n\nAvailable for **Staff Tokens**.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivitySourceCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "https://vcita.github.io/developers-hub/entities/clients/activity_source.json"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "success": true,
                  "data": {
                    "uid": "3rizqwm5l4ygffdu",
                    "business_uid": "d3f8a1k9p2m7x4qz",
                    "source_name": "website",
                    "source_channel": "scheduler_widget",
                    "source_campaign": null,
                    "source_url": "https://www.example.com/book",
                    "utm_params": null,
                    "created_at": "2026-10-30T07:32:31Z",
                    "updated_at": "2026-10-30T07:32:31Z"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "errors": [
                    {
                      "field": "source_name",
                      "code": "too_long",
                      "message": "source_name must be at most 255 characters"
                    }
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "Activity Source"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v3/clients/activity_sources/{uid}": {
      "get": {
        "operationId": "getActivitySource",
        "summary": "Retrieve an ActivitySource",
        "description": "## Overview\nRetrieve one ActivitySource of the business by its unique identifier (UID).\n\nAvailable for **Staff Tokens**.",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "description": "The unique identifier of the ActivitySource entity.",
            "schema": {
              "type": "string"
            },
            "example": "3rizqwm5l4ygffdu"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "https://vcita.github.io/developers-hub/entities/clients/activity_source.json"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "success": true,
                  "data": {
                    "uid": "3rizqwm5l4ygffdu",
                    "business_uid": "d3f8a1k9p2m7x4qz",
                    "source_name": "website",
                    "source_channel": "scheduler_widget",
                    "source_campaign": null,
                    "source_url": "https://www.example.com/book",
                    "utm_params": null,
                    "created_at": "2026-10-30T07:32:31Z",
                    "updated_at": "2026-10-30T07:32:31Z"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "ActivitySource not found in this business",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "errors": [
                    {
                      "code": "missing",
                      "message": "Source not found"
                    }
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "Activity Source"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "The token is missing or may not use this endpoint",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "errors": [
                {
                  "code": "unauthorized",
                  "message": "Unauthorized"
                }
              ]
            }
          }
        }
      }
    },
    "schemas": {
      "ActivitySourcesList": {
        "type": "object",
        "properties": {
          "activity_sources": {
            "description": "List of ActivitySources",
            "type": "array",
            "items": {
              "$ref": "https://vcita.github.io/developers-hub/entities/clients/activity_source.json"
            }
          }
        }
      },
      "ActivitySourceCreateRequest": {
        "type": "object",
        "description": "The fields of the new activity source. Every field is optional.",
        "properties": {
          "source_name": {
            "$ref": "https://vcita.github.io/developers-hub/entities/clients/activity_source.json#/properties/source_name"
          },
          "source_channel": {
            "$ref": "https://vcita.github.io/developers-hub/entities/clients/activity_source.json#/properties/source_channel"
          },
          "source_campaign": {
            "$ref": "https://vcita.github.io/developers-hub/entities/clients/activity_source.json#/properties/source_campaign"
          },
          "source_url": {
            "type": "string",
            "nullable": true,
            "description": "The page where the activity started: the business website page with a widget, the client portal page, the online scheduling page, or the link of a message. Longer values are cut to 255 characters.",
            "example": "https://www.example.com/book"
          },
          "utm_params": {
            "type": "object",
            "nullable": true,
            "description": "The marketing parameters of the visit that created the source: the five UTM parameters and the Google Ads click identifier (`gclid`). Stored only for businesses with the sales account feature. Other keys are rejected.",
            "properties": {
              "utm_source": {
                "type": "string",
                "nullable": true,
                "maxLength": 255,
                "description": "The UTM source, for example `adwords`."
              },
              "utm_medium": {
                "type": "string",
                "nullable": true,
                "maxLength": 255,
                "description": "The UTM medium, for example `ppc`."
              },
              "utm_campaign": {
                "type": "string",
                "nullable": true,
                "maxLength": 255,
                "description": "The UTM campaign."
              },
              "utm_term": {
                "type": "string",
                "nullable": true,
                "maxLength": 255,
                "description": "The UTM term."
              },
              "utm_content": {
                "type": "string",
                "nullable": true,
                "maxLength": 255,
                "description": "The UTM content."
              },
              "gclid": {
                "type": "string",
                "nullable": true,
                "maxLength": 255,
                "description": "The Google Ads click identifier."
              }
            },
            "additionalProperties": false,
            "example": null
          }
        },
        "example": {
          "source_name": "website",
          "source_channel": "scheduler_widget",
          "source_url": "https://www.example.com/book"
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ],
            "example": false
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "The request field the error is about, when there is one (e.g., \"uid\", \"source_name\")."
                },
                "code": {
                  "type": "string",
                  "description": "The error code (e.g., \"invalid\", \"too_long\", \"missing\", \"unauthorized\")."
                },
                "message": {
                  "type": "string",
                  "description": "A readable description of the error (e.g., \"Source not found\")."
                }
              },
              "required": [
                "code",
                "message"
              ]
            }
          }
        },
        "required": [
          "success",
          "errors"
        ]
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Provide a valid bearer token in the Authorization header. Example: 'Authorization: Bearer {token}'"
      }
    }
  }
}
