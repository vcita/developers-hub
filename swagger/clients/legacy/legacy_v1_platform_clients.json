{
  "basePath": "/platform/v1",
  "host": "api.vcita.biz",
  "info": {
    "title": "Platform Administration Legacy API v1",
    "version": "v1.0",
    "description": "Legacy v1 Platform API endpoints for platform administration domain including businesses, staff, tokens, webhooks, categories, fields, forms, and directory management"
  },
  "securityDefinitions": {
    "default": {
      "authorizationUrl": "https://ignore.myclients.io",
      "flow": "implicit",
      "scopes": {
        "platform": "All platform related operations",
        "platform_create": "platform create scope",
        "platform_delete": "platform delete scope",
        "platform_read": "platform read scope",
        "platform_update": "platform update scope"
      },
      "type": "oauth2",
      "x-scopes-bindings": {
        "platform": "",
        "platform_create": "",
        "platform_delete": "",
        "platform_read": "",
        "platform_update": ""
      }
    }
  },
  "swagger": "2.0",
  "paths": {
    "/fields": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "## Overview\nGet custom fields list.\n\nEvery business starts with the built-in `contact` fields Email, First Name, Last Name, Phone, Address, and Birthday; fields created with `POST /platform/v1/fields` are listed after them.\n\n## Response shape\n`data` is a flat array of field definitions, not an object. Each element has `id` (the field UID), `type`, `label`, `object_type` (`contact` or `matter`), `required`, and `deleted`; dropdown fields also carry `options`. Contact-level and matter-level fields come back together, in position order, and deleted fields are included (`deleted: true`).\n\n## No filtering or paging\nThe endpoint takes no query parameters: it always returns every field of the business in one response. To find a specific field, filter the array on the client side. For example, the matter name field required by `POST /business/clients/v1/contacts/{client_uid}/matters` is the element with `type == \"name\"`, `object_type == \"matter\"` and `deleted == false`; its position in the array is not fixed.",
        "parameters": [],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "examples": {
              "application/json": {
                "data": [
                  {
                    "id": "c3k9x1p2m8q7r4tz",
                    "type": "email",
                    "label": "Email",
                    "required": false,
                    "keep_asking": false,
                    "default_value": "",
                    "forms": [],
                    "object_type": "contact",
                    "deleted": false
                  },
                  {
                    "id": "hfv05wachtec1bvp",
                    "type": "name",
                    "label": "Name",
                    "required": true,
                    "keep_asking": false,
                    "default_value": "",
                    "forms": [],
                    "object_type": "matter",
                    "deleted": false
                  }
                ],
                "status": "OK"
              }
            }
          }
        },
        "security": [
          {
            "default": [
              "platform"
            ]
          }
        ],
        "summary": "Get Fields List",
        "tags": [
          "Fields"
        ],
        "x-amazon-apigateway-auth": {
          "type": "NONE"
        },
        "x-amazon-apigateway-integration": {
          "httpMethod": "GET",
          "responses": {
            "default": {
              "statusCode": "200"
            }
          },
          "type": "http_proxy",
          "uri": "https:///platform/v1/fields"
        },
        "x-auth-type": "Application & Application User"
      },
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "## Overview\nCreate a custom field for contacts or matters.\n\n## Built-in contact fields\nEvery business already has these `contact` fields: Email, First Name, Last Name, Phone, Address, and Birthday (a `datepicker`). Do not create them: field labels are unique on the business, so creating a field with one of these labels is rejected with HTTP 422, even as a `matter` field. Use `GET /platform/v1/fields` to find an existing field's `id`.\n\n## Object Types\n- `contact` - Fields for client/contact records\n- `matter` - Fields for matter records\n\n## Field Types\n- `singleline` - Single line text\n- `dropdown` - Dropdown selection (requires `options`)\n- `datepicker` - Date picker\n- `checkbox` - Boolean checkbox\n- `address` - Address field\n- `identifier` - Unique identifier\n\n**Available for Staff, App, and Directory tokens**",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["type", "label"],
              "properties": {
                "type": {
                  "description": "Field type: singleline, name (for matter names), dropdown, datepicker, checkbox, address, identifier, email, firstname, lastname, phone, opt-in, status.",
                  "type": "string"
                },
                "label": {
                  "description": "Display label for the field",
                  "type": "string"
                },
                "object_type": {
                  "description": "The object type this field belongs to. Use 'matter' for matter fields, 'contact' for client/contact fields. Default: 'matter'",
                  "type": "string",
                  "enum": ["contact", "matter"],
                  "default": "matter"
                },
                "default_value": {
                  "description": "Default value for checkbox/opt-in fields",
                  "type": "boolean"
                },
                "forms": {
                  "description": "A list of forms to include this field. Options: client_card, leave_details, scheduling, online_payments, share_documents",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "keep_asking": {
                  "description": "Indicates if to keep asking until filled",
                  "type": "boolean"
                },
                "options": {
                  "description": "A list of options for dropdown field type",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "required": {
                  "description": "Indicates if the field is required",
                  "type": "boolean"
                }
              }
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "201": {
            "description": "Success",
            "examples": {
              "application/json": {
                "data": {
                  "default_value": "",
                  "deleted": false,
                  "forms": [
                    "client_card",
                    "leave_details",
                    "share_documents"
                  ],
                  "id": "xo08llu7mfiyocar",
                  "keep_asking": true,
                  "label": "Eye color",
                  "object_type": "contact",
                  "options": [
                    "Brown",
                    "Green"
                  ],
                  "required": false,
                  "type": "dropdown"
                },
                "status": "OK"
              }
            }
          }
        },
        "security": [
          {
            "default": [
              "platform"
            ]
          }
        ],
        "summary": "Create a New Field",
        "tags": [
          "Fields"
        ],
        "x-amazon-apigateway-auth": {
          "type": "NONE"
        },
        "x-amazon-apigateway-integration": {
          "httpMethod": "POST",
          "responses": {
            "default": {
              "statusCode": "201"
            }
          },
          "type": "http_proxy",
          "uri": "https:///platform/v1/fields"
        },
        "x-auth-type": "Application & Application User"
      }
    },
    "/fields/{field_id}": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "## Overview\nGet specific field details.",
        "parameters": [
          {
            "description": "Field ID",
            "in": "path",
            "name": "field_id",
            "required": true,
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "examples": {
              "application/json": {
                "data": {
                  "field": {}
                },
                "status": "OK"
              }
            }
          }
        },
        "security": [
          {
            "default": [
              "platform"
            ]
          }
        ],
        "summary": "Get Field Details",
        "tags": [
          "Fields"
        ],
        "x-amazon-apigateway-auth": {
          "type": "NONE"
        },
        "x-amazon-apigateway-integration": {
          "httpMethod": "GET",
          "responses": {
            "default": {
              "statusCode": "200"
            }
          },
          "type": "http_proxy",
          "uri": "https:///platform/v1/fields/{field_id}"
        },
        "x-auth-type": "Application & Application User"
      },
      "put": {
        "consumes": [
          "application/json"
        ],
        "description": "## Overview\nUpdates a Field Available for **Staff, App, and Directory tokens**.",
        "parameters": [
          {
            "description": "The id of the field",
            "in": "path",
            "name": "field_id",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "body",
            "schema": {
              "properties": {
                "default_value": {
                  "description": "Default value for checkbox/opt-in",
                  "type": "boolean"
                },
                "forms": {
                  "description": "A list of forms to include this field",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "keep_asking": {
                  "description": "Indicates if to keep asking until filled",
                  "type": "boolean"
                },
                "label": {
                  "description": "Field label",
                  "type": "string"
                },
                "options": {
                  "description": "A list of options for dropdown field",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "required": {
                  "description": "Indicates if the field is required",
                  "type": "boolean"
                }
              },
              "type": "object"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "examples": {
              "application/json": {
                "data": {
                  "default_value": "",
                  "deleted": false,
                  "forms": [
                    "client_card",
                    "leave_details",
                    "share_documents"
                  ],
                  "id": "8m0hvhge0w9m1yuc",
                  "keep_asking": true,
                  "label": "Colors",
                  "object_type": "matter",
                  "options": [
                    "Red",
                    "Green"
                  ],
                  "required": false,
                  "type": "dropdown"
                },
                "status": "OK"
              }
            }
          }
        },
        "security": [
          {
            "default": [
              "platform"
            ]
          }
        ],
        "summary": "Updates a Field",
        "tags": [
          "Fields"
        ],
        "x-amazon-apigateway-auth": {
          "type": "NONE"
        },
        "x-amazon-apigateway-integration": {
          "httpMethod": "PUT",
          "responses": {
            "default": {
              "statusCode": "200"
            }
          },
          "type": "http_proxy",
          "uri": "https:///platform/v1/fields/{field_id}"
        },
        "x-auth-type": "Application & Application User"
      },
      "delete": {
        "consumes": [
          "application/json"
        ],
        "description": "## Overview\nDeletes a Field Available for **Staff, App, and Directory tokens**.",
        "parameters": [
          {
            "description": "The id of the field",
            "in": "path",
            "name": "field_id",
            "required": true,
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "examples": {
              "application/json": {
                "status": "OK"
              }
            }
          }
        },
        "security": [
          {
            "default": [
              "platform"
            ]
          }
        ],
        "summary": "Deletes a Field",
        "tags": [
          "Fields"
        ],
        "x-amazon-apigateway-auth": {
          "type": "NONE"
        },
        "x-amazon-apigateway-integration": {
          "httpMethod": "DELETE",
          "responses": {
            "default": {
              "statusCode": "200"
            }
          },
          "type": "http_proxy",
          "uri": "https:///platform/v1/fields/{field_id}"
        },
        "x-auth-type": "Application & Application User"
      }
    }
  },
  "components": {
