      "patch": {
        "operationId": "updatePaymentPlan",
        "summary": "Update a PaymentPlan",
        "description": "Update a PaymentPlan. Only two fields are accepted:\n\n* `payment_method` — charge a different saved card from the next installment onwards.\n* `status` — set to `cancelled` to stop the plan. No further installment is collected. Installments already collected are not refunded, and for a linked plan they stay applied to the invoice. `cancelled` is the only status a client may set, and only while the plan is `active`.\n\nAvailable for **Staff Tokens**.",
        "parameters": [
          {
            "name": "uid",
            "required": true,
            "in": "path",
            "description": "Unique identifier of the PaymentPlan",
            "schema": {
              "type": "string"
            },
            "example": "7gilictbt12jir3v"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "At least one of `payment_method` or `status` must be supplied.",
                "properties": {
                  "payment_method": {
                    "$ref": "https://vcita.github.io/developers-hub/entities/sales/paymentPlan.json#/properties/payment_method"
                  },
                  "status": {
                    "type": "string",
                    "description": "Set to `cancelled` to stop the plan. This is the only value a client may set (e.g., \"cancelled\")",
                    "enum": [
                      "cancelled"
                    ]
                  }
                },
                "minProperties": 1
              },
              "example": {
                "status": "cancelled"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated PaymentPlan",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "$ref": "https://vcita.github.io/developers-hub/entities/sales/paymentPlan.json"
