  "openapi": "3.0.0",
  "info": {
    "title": "Payment Plans",
    "description": "A set of endpoints to manage payment plans in the sales domain. A payment plan collects a fixed amount from a client's saved card on a recurring schedule. A plan is either **standalone**, where every installment is an independent charge, or **linked** to a payment request through `payment_request_uid`, where every installment is collected against an open invoice and reduces its balance until it is fully paid.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "https://api.vcita.biz",
      "description": "API Gateway server"
    }
  ],
