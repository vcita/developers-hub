          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number of results.",
            "schema": {
              "minimum": 1,
              "maximum": 10000,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "per_page",
            "required": false,
            "in": "query",
            "description": "How many items to return per page. Max: 100",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "type": "number"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "description": "Sort by fields. Example: sort=next_payment_time:asc,created_at:desc",
            "schema": {
              "default": "updated_at:desc",
              "type": "string"
            }
          },
          {
            "name": "payment_request_uid",
            "required": false,
            "in": "query",
            "description": "Return only plans linked to this payment request. Combine with `status=active` to check whether an invoice already has a running plan.",
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6g7h8"
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Return only plans in this state. Note that a plan stopped by a declined charge is reported as `cancelled`, not as a distinct failed state.",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "completed",
                "cancelled"
              ]
            },
            "example": "active"
          },
          {
            "name": "matter_uid",
            "required": false,
            "in": "query",
            "description": "Return only plans belonging to this matter.",
