      "post": {
        "operationId": "createPaymentPlan",
        "summary": "Create a PaymentPlan",
        "description": "Create a PaymentPlan that charges the client's saved card on a recurring schedule. Omit `payment_request_uid` for a standalone plan; supply it to collect against an open invoice.\n\n`amount` is validated, not derived. For a linked plan, divide the invoice's open balance by `cycles` and **round up** to two decimals — the final installment is then clamped down to the balance that actually remains, so the invoice lands on exactly zero. A 1,000.00 invoice over 3 cycles takes `amount: 333.34`, collecting 333.34, 333.34 and 333.32.\n\n`cycles` is required for every `frequency_type` except `one_time`, where it is ignored and stored as 1.\n\nAvailable for **Staff Tokens**.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "$ref": "https://vcita.github.io/developers-hub/entities/sales/paymentPlan.json#/properties/name"
                  },
                  "description": {
                    "$ref": "https://vcita.github.io/developers-hub/entities/sales/paymentPlan.json#/properties/description"
                  },
                  "payment_request_uid": {
                    "$ref": "https://vcita.github.io/developers-hub/entities/sales/paymentPlan.json#/properties/payment_request_uid"
                  },
                  "amount": {
                    "$ref": "https://vcita.github.io/developers-hub/entities/sales/paymentPlan.json#/properties/amount"
                  },
                  "currency": {
                    "$ref": "https://vcita.github.io/developers-hub/entities/sales/paymentPlan.json#/properties/currency"
                  },
                  "cycles": {
                    "$ref": "https://vcita.github.io/developers-hub/entities/sales/paymentPlan.json#/properties/cycles"
                  },
                  "frequency_type": {
                    "$ref": "https://vcita.github.io/developers-hub/entities/sales/paymentPlan.json#/properties/frequency_type"
                  },
                  "start_date": {
                    "$ref": "https://vcita.github.io/developers-hub/entities/sales/paymentPlan.json#/properties/start_date"
                  },
                  "matter_uid": {
                    "$ref": "https://vcita.github.io/developers-hub/entities/sales/paymentPlan.json#/properties/matter_uid"
                  },
                  "send_receipt": {
                    "$ref": "https://vcita.github.io/developers-hub/entities/sales/paymentPlan.json#/properties/send_receipt"
                  },
                  "payment_method": {
                    "$ref": "https://vcita.github.io/developers-hub/entities/sales/paymentPlan.json#/properties/payment_method"
                  }
                },
                "required": [
                  "name",
                  "amount",
                  "currency",
                  "frequency_type",
                  "start_date",
                  "matter_uid",
                  "send_receipt",
                  "payment_method"
                ]
              },
              "example": {
                "name": "Kitchen remodel plan",
                "description": "3 monthly installments for invoice #1042",
                "payment_request_uid": "a1b2c3d4e5f6g7h8",
                "amount": 333.34,
                "currency": "USD",
                "cycles": 3,
                "frequency_type": "monthly",
                "start_date": "2026-09-01T09:00:00Z",
                "matter_uid": "m1m2m3m4m5m6m7m8",
                "send_receipt": true,
                "payment_method": {
                  "type": "card",
                  "uid": "c1c2c3c4c5c6c7c8"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The PaymentPlan was created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
