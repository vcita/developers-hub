{
  "openapi": "3.0.3",
  "info": {
    "title": "Sources",
    "description": "Create and read the sources of a business under `/v3/online_presence/sources`. A source tells how an activity (a client, an appointment, a payment, an invoice, a document, a review or a cart) started.\n\nEvery call is scoped to one business: a source of another business returns 404, the same as a missing one.",
    "version": "3.0.0",
    "contact": {}
  },
  "servers": [
    {
      "url": "https://api.vcita.biz",
      "description": "API Gateway server"
    }
  ],
  "tags": [
    {
      "name": "Source"
    }
  ],
  "paths": {
    "/v3/online_presence/sources": {
      "get": {
        "summary": "Get all Sources",
        "description": "## Overview\nGet the sources of a business, newest first, with pagination. With the `uid` filter, get the sources of a whole page of activities in one call; the filter returns every match, with no pagination.\n\nAvailable for **Staff Tokens**, **Directory Tokens** (with `business_uid` of a business of the directory) and **Admin Tokens** (with `business_uid`).",
        "parameters": [
          {
            "name": "business_uid",
            "in": "query",
            "required": false,
            "description": "The business of the sources. Required for every token except a staff token, which gives its own business and ignores this parameter.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "uid",
            "in": "query",
            "required": false,
            "description": "Filter by source identifiers, as a comma list (`uid=a1,a2`) or repeated (`uid[]=a1&uid[]=a2`). At most 500 values. Each value is A `uid`, or the legacy numeric `source_id` (1 to 10 digits). **The legacy `source_id` form is deprecated**: use the `uid`.",
            "schema": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number of results",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "How many items to return per page. Max: 100",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort by creation time. Example: sort=created_at:asc",
            "schema": {
              "type": "string",
              "enum": [
                "created_at:desc",
                "created_at:asc"
              ],
              "default": "created_at:desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "$ref": "#/components/schemas/SourcesList"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized: the token may not act on this business",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid parameters, or `business_uid` is missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Source"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      },
      "post": {
        "summary": "Create a Source",
        "description": "## Overview\nCreate a source for a business, then store its `uid` (or, for the legacy APIs, its deprecated `source_id`) on the activity it describes. The UTM fields and `gclid` are stored only for businesses with the sales account feature, and are ignored for the others.\n\nAvailable for **Staff Tokens**, **Directory Tokens** (with `business_uid` of a business of the directory) and **Admin Tokens** (with `business_uid`).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "https://vcita.github.io/developers-hub/entities/online_presence/source.json"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized: the token may not act on this business",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Business not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error, or `business_uid` is missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Source"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v3/online_presence/sources/{uid}": {
      "get": {
        "summary": "Get a Source",
        "description": "## Overview\nGet one source of a business.\n\nAvailable for **Staff Tokens**, **Directory Tokens** (with `business_uid` of a business of the directory) and **Admin Tokens** (with `business_uid`).",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "description": "A `uid`, or the legacy numeric `source_id` (1 to 10 digits). **The legacy `source_id` form is deprecated**: use the `uid`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "business_uid",
            "in": "query",
            "required": false,
            "description": "The business of the sources. Required for every token except a staff token, which gives its own business and ignores this parameter.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "https://vcita.github.io/developers-hub/entities/online_presence/source.json"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized: the token may not act on this business",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Source not found, or the source belongs to another business",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "`business_uid` is missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Source"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "SourcesList": {
        "type": "object",
        "properties": {
          "sources": {
            "description": "List of Sources",
            "type": "array",
            "items": {
              "$ref": "https://vcita.github.io/developers-hub/entities/online_presence/source.json"
            }
          }
        }
      },
      "SourceCreateRequest": {
        "type": "object",
        "properties": {
          "business_uid": {
            "type": "string",
            "description": "The business of the source. Required for every token except a staff token."
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "description": "How the activity started. See the `name` field of the Source entity for the known values.",
            "nullable": true
          },
          "channel": {
            "type": "string",
            "maxLength": 255
          },
          "campaign": {
            "type": "string",
            "maxLength": 255
          },
          "website_url": {
            "type": "string",
            "description": "Values longer than 255 characters are cut."
          },
          "utm_source": {
            "type": "string",
            "maxLength": 255
          },
          "utm_medium": {
            "type": "string",
            "maxLength": 255
          },
          "utm_campaign": {
            "type": "string",
            "maxLength": 255
          },
          "utm_term": {
            "type": "string",
            "maxLength": 255
          },
          "utm_content": {
            "type": "string",
            "maxLength": 255
          },
          "gclid": {
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "A staff token, a directory token or an Admin token. Every token except a staff token names the business with `business_uid`."
      }
    }
  }
}
