{
  "openapi": "3.0.3",
  "info": {
    "title": "Sources",
    "description": "A source tells how an activity started: a client, an appointment, a payment, an invoice, a document, a review or a cart.\n\n**Business scope.** List, get and create act on one business. A staff token gives its business. Every other token names it with `business_uid`: a directory token or an app token of a directory, for a business of its directory; an Admin token or a global app token (an app of no directory), for any business. A source of another business returns 404.\n\n**Cross-tenant reads.** An Admin token or a global app token can read the sources of every business: the list without `business_uid` (by `uid`), and the tap. Each source then carries its `business_uid`.",
    "version": "3.0.0",
    "contact": {}
  },
  "servers": [
    {
      "url": "https://api.vcita.biz",
      "description": "API Gateway server"
    }
  ],
  "tags": [
    {
      "name": "Source"
    }
  ],
  "paths": {
    "/v3/online_presence/sources": {
      "get": {
        "summary": "Get all Sources",
        "description": "## Overview\nGet the sources of a business, with pagination.\n\nWith `uid`, get the listed sources in one call, with no pagination. Use it to get the sources of a page of activities.\n\nWithout `business_uid`, an Admin token or a global app token gets the listed sources of every business (`uid` is then required). Each source carries its `business_uid`.\n\nAvailable for **Staff**, **Directory**, **App** and **Admin Tokens**.",
        "parameters": [
          {
            "$ref": "#/components/parameters/business_uid"
          },
          {
            "name": "uid",
            "in": "query",
            "required": false,
            "description": "Source identifiers, as a comma list (`uid=a1,a2`) or repeated (`uid[]=a1&uid[]=a2`). At most 500. A value of 1 to 10 digits is a legacy `source_id` (**deprecated**).",
            "schema": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Ignored with `uid`.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Items per page. Ignored with `uid`.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort by creation time.",
            "schema": {
              "type": "string",
              "enum": [
                "created_at:desc",
                "created_at:asc"
              ],
              "default": "created_at:desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "$ref": "#/components/schemas/SourcesList"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "description": "Invalid parameters, `business_uid` is missing, or `uid` is missing in a cross-tenant read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Source"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      },
      "post": {
        "summary": "Create a Source",
        "description": "## Overview\nCreate a source for a business. Store its `uid` on the activity it describes.\n\nThe UTM fields and `gclid` are stored only for businesses with the sales account feature.\n\nAvailable for **Staff**, **Directory**, **App** and **Admin Tokens**.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "https://vcita.github.io/developers-hub/entities/online_presence/source.json"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Business not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error, or `business_uid` is missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Source"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v3/online_presence/sources/tap": {
      "get": {
        "summary": "Read all Sources (tap)",
        "description": "## Overview\nRead the sources of every business, ordered by `updated_at`, then `uid`.\n\nThe first request sends `date` (and optionally `end_date`). Each next request sends only the `offset` of the previous response. Stop when `entities` is empty, or when you reach the end of your window: a request with `offset` has no upper bound.\n\nThe tap returns `business_uid` (null for a source of no business) and no `source_id`.\n\nAvailable for **Admin Tokens** and **global App Tokens** (an app of no directory).",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "First request only: the start of the window (ISO 8601), on `updated_at`.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "description": "First request only: the end of the window (ISO 8601, excluded). Default: `date` plus one hour.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "The `offset` of the previous response.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Items per page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SourcesTapPage"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "description": "Invalid parameters, or neither `date` nor `offset`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Source"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v3/online_presence/sources/{uid}": {
      "get": {
        "summary": "Get a Source",
        "description": "## Overview\nGet one source of a business.\n\nAvailable for **Staff**, **Directory**, **App** and **Admin Tokens**.",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "description": "The source `uid`. A value of 1 to 10 digits is a legacy `source_id` (**deprecated**).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/business_uid"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "https://vcita.github.io/developers-hub/entities/online_presence/source.json"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Source not found in this business",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "`business_uid` is missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Source"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "parameters": {
      "business_uid": {
        "name": "business_uid",
        "in": "query",
        "required": false,
        "description": "The business. Required for every token except a staff token.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "The token may not act on this business, or may not read across businesses",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "SourcesList": {
        "type": "object",
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "$ref": "https://vcita.github.io/developers-hub/entities/online_presence/source.json"
            }
          }
        }
      },
      "SourcesTapPage": {
        "type": "object",
        "properties": {
          "entities": {
            "type": "array",
            "items": {
              "$ref": "https://vcita.github.io/developers-hub/entities/online_presence/source.json"
            }
          },
          "offset": {
            "type": "string",
            "description": "Send it as `offset` to get the next page."
          }
        }
      },
      "SourceCreateRequest": {
        "type": "object",
        "properties": {
          "business_uid": {
            "type": "string",
            "description": "The business. Required for every token except a staff token."
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "nullable": true,
            "description": "How the activity started. See the Source entity for the known values."
          },
          "channel": {
            "type": "string",
            "maxLength": 255
          },
          "campaign": {
            "type": "string",
            "maxLength": 255
          },
          "website_url": {
            "type": "string",
            "description": "Cut to 255 characters."
          },
          "utm_source": {
            "type": "string",
            "maxLength": 255
          },
          "utm_medium": {
            "type": "string",
            "maxLength": 255
          },
          "utm_campaign": {
            "type": "string",
            "maxLength": 255
          },
          "utm_term": {
            "type": "string",
            "maxLength": 255
          },
          "utm_content": {
            "type": "string",
            "maxLength": 255
          },
          "gclid": {
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "A staff, directory, app or Admin token."
      }
    }
  }
}
