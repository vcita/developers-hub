{
  "openapi": "3.0.3",
  "info": {
    "title": "Online Presence — AI Receptionist Insights",
    "description": "Read APIs for the AI Receptionist Insights tab. `GET /v3/online_presence/ai_receptionist_questions` lists the distinct questions customers asked the receptionist in a period, how often, and how confident the receptionist was when answering, built from a ledger the service keeps up to date at every conversation close.",
    "version": "3.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "AI Receptionist Insights",
      "description": "What customers ask the AI Receptionist, for the authenticated business (**Staff, App and Business tokens**)."
    }
  ],
  "servers": [
    {
      "url": "https://api.vcita.biz",
      "description": "API Gateway server"
    }
  ],
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "**Staff, App and Business tokens** — business context is taken from the token."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "description": "Standard v3 error envelope.",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Always false for error responses.",
            "enum": [
              false
            ]
          },
          "errors": {
            "type": "array",
            "description": "List of error details describing what failed.",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "nullable": true,
                  "description": "Request field that failed validation, when applicable."
                },
                "code": {
                  "type": "string",
                  "description": "Machine-readable error code."
                },
                "message": {
                  "type": "string",
                  "description": "Human-readable error message."
                }
              },
              "required": [
                "code",
                "message"
              ]
            }
          }
        },
        "required": [
          "success",
          "errors"
        ]
      },
      "QuestionsReportPayload": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "ledger"
            ],
            "description": "Where the report comes from. Always `ledger`."
          },
          "window": {
            "type": "object",
            "properties": {
              "range": {
                "type": "string",
                "enum": [
                  "7d",
                  "30d",
                  "3m",
                  "6m",
                  "1y"
                ]
              },
              "start_date": {
                "type": "string",
                "format": "date-time"
              },
              "end_date": {
                "type": "string",
                "format": "date-time"
              },
              "generated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "filters": {
            "type": "object",
            "properties": {
              "channel": {
                "type": "string",
                "enum": [
                  "all",
                  "web",
                  "voice",
                  "messaging",
                  "assistant"
                ]
              },
              "app": {
                "type": "string",
                "nullable": true,
                "description": "The messaging app filter, lowercased, or null."
              },
              "simulated": {
                "type": "string",
                "enum": [
                  "exclude",
                  "only",
                  "all"
                ]
              }
            }
          },
          "questions": {
            "type": "array",
            "description": "Sorted by `count`, descending.",
            "items": {
              "$ref": "https://vcita.github.io/developers-hub/entities/online_presence/AiReceptionistQuestion.json"
            }
          }
        },
        "required": [
          "source",
          "window",
          "filters",
          "questions"
        ]
      }
    }
  },
  "paths": {
    "/v3/online_presence/ai_receptionist_questions": {
      "get": {
        "operationId": "listAiReceptionistQuestions",
        "summary": "Get the questions customers asked the AI Receptionist",
        "description": "Returns the distinct questions customers asked the receptionist in a trailing period, how often each was asked, the receptionist's average confidence when answering, every ask with a link to its conversation, and whether an answer has been applied. Questions are grouped across wordings and languages and written in the business's language; booking-flow steps (picking a slot, confirming) are not included. Simulated (test) conversations are never included, so `simulated=only` returns an empty list. Available for **Staff, App and Business tokens**.",
        "tags": [
          "AI Receptionist Insights"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "range",
            "in": "query",
            "description": "Trailing period ending now.",
            "schema": {
              "type": "string",
              "enum": [
                "7d",
                "30d",
                "3m",
                "6m",
                "1y"
              ],
              "default": "3m"
            }
          },
          {
            "name": "channel",
            "in": "query",
            "description": "Only asks from conversations on this channel.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "web",
                "voice",
                "messaging",
                "assistant"
              ],
              "default": "all"
            }
          },
          {
            "name": "app",
            "in": "query",
            "description": "Only asks from conversations of this messaging app, by the app id comm-gw stored with the conversation (for example `messenger`, `instagramdm`). Compared case-insensitively.",
            "schema": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.-]+$"
            }
          },
          {
            "name": "simulated",
            "in": "query",
            "description": "Simulated conversations are never part of the ledger; `only` therefore returns no questions.",
            "schema": {
              "type": "string",
              "enum": [
                "exclude",
                "only",
                "all"
              ],
              "default": "exclude"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The report (`{ success: true, data: { source, window, filters, questions } }`)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/QuestionsReportPayload"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "success": true,
                  "data": {
                    "source": "ledger",
                    "window": {
                      "range": "3m",
                      "start_date": "2026-07-16T00:00:00.000Z",
                      "end_date": "2026-10-16T14:00:00.000Z",
                      "generated_at": "2026-10-16T14:00:00.000Z"
                    },
                    "filters": {
                      "channel": "all",
                      "simulated": "exclude"
                    },
                    "questions": [
                      {
                        "question_uid": "7a9908af-39c9-4e3c-b8d7-f36789e392c4",
                        "question": "When is Handyman for a Day available?",
                        "count": 3,
                        "avg_certainty": 4.3,
                        "conversions": 2,
                        "conversion_rate": 33,
                        "answered": false,
                        "occurrences": [
                          {
                            "conversation_uid": "92346484-1d5b-470a-9d39-9d680b7b9ad9",
                            "text": "What days are open for Handyman for a Day?",
                            "asked_at": "2026-09-13T12:37:55.000Z",
                            "certainty": 4,
                            "message_index": 0
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "errors": [
                    {
                      "code": "unauthorized",
                      "message": "Authentication required"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "errors": [
                    {
                      "code": "forbidden",
                      "message": "Access denied"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
