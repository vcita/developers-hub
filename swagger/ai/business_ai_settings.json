{
  "openapi": "3.0.3",
  "info": {
    "title": "Business AI Settings API",
    "version": "1.0.0",
    "description": "API for managing business-level AI settings"
  },
  "servers": [
    {
      "url": "https://api.vcita.biz",
      "description": "API Gateway server"
    }
  ],
  "paths": {
    "/v3/ai/business_ai_settings/{business_uid}": {
      "get": {
        "tags": ["Business AI Settings"],
        "operationId": "getBusinessAiSettings",
        "summary": "Retrieve a BusinessAiSettings",
        "description": "## Overview\nRetrieve the AI settings of a business. Every known key is returned, with its default filled in for keys the business has never changed, so the response is the same whether or not the business has stored settings.\n\nA Staff token can only read the settings of its own business. A Directory token can read the settings of any business in its directory.\n\nAvailable for **Staff, Directory and Application tokens**",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "business_uid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier of the business (e.g., \"biz_abc123\")",
            "example": "biz_abc123"
          }
        ],
        "responses": {
          "200": {
            "description": "Business AI settings retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "business_ai_settings": {
                              "$ref": "https://vcita.github.io/developers-hub/entities/ai/businessAiSettings.json"
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "success": true,
                  "data": {
                    "business_ai_settings": {
                      "uid": "bas_9f31c2",
                      "business_uid": "biz_abc123",
                      "settings": {
                        "note_summary": {
                          "allow": true
                        },
                        "opted_in": {
                          "allow": false
                        },
                        "client_agent": {
                          "allow": true
                        },
                        "pulse_client_agent": {
                          "allow": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "errors": [
                    {
                      "code": "unauthorized",
                      "message": "Unauthorized"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - the settings belong to another business, or to a business outside the token's directory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "errors": [
                    {
                      "code": "forbidden",
                      "message": "You do not have access to these business AI settings"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Business AI Settings"],
        "operationId": "updateBusinessAiSettings",
        "summary": "Update a BusinessAiSettings",
        "description": "## Overview\nCreate or update the AI settings of a business. Keys left out of the request keep their stored value, and unknown keys are rejected.\n\nWho may change which key:\n- A Staff token holding the `account.settings.manage` permission can change every key except `pulse_client_agent`, and only for its own business.\n- A Directory token can change every key for any business in its directory. This is how a partner opts a business in to or out of Pulse and the AI Client Agent.\n- An Application token can change every key for any business.\n\nA Staff token that sends `pulse_client_agent` is rejected with HTTP 403 and nothing is changed, even when the request also carries keys the staff member may change.\n\nAvailable for **Staff, Directory and Application tokens**",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "business_uid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier of the business (e.g., \"biz_abc123\")",
            "example": "biz_abc123"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BusinessAiSettingsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Business AI settings updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "https://vcita.github.io/developers-hub/entities/response.json"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "business_ai_settings": {
                              "$ref": "https://vcita.github.io/developers-hub/entities/ai/businessAiSettings.json"
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "success": true,
                  "data": {
                    "business_ai_settings": {
                      "uid": "bas_9f31c2",
                      "business_uid": "biz_abc123",
                      "settings": {
                        "note_summary": {
                          "allow": true
                        },
                        "opted_in": {
                          "allow": false
                        },
                        "client_agent": {
                          "allow": false
                        },
                        "pulse_client_agent": {
                          "allow": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - malformed request or unknown setting key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "errors": [
                    {
                      "code": "bad_request",
                      "message": "Unknown AI setting key(s): ai_global. Allowed keys: note_summary, opted_in, client_agent, pulse_client_agent"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "errors": [
                    {
                      "code": "unauthorized",
                      "message": "Unauthorized"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - the settings belong to another business or to a business outside the token's directory, the staff member lacks the account.settings.manage permission, or a Staff token sent the pulse_client_agent key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "errors": [
                    {
                      "code": "forbidden",
                      "message": "Setting key(s) pulse_client_agent can only be changed by the business's partner"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": ["success", "errors"]
      },
      "BusinessAiSettingsRequest": {
        "type": "object",
        "properties": {
          "settings": {
            "type": "object",
            "description": "Settings to change. Keys that are omitted keep their stored value",
            "properties": {
              "note_summary": {
                "type": "object",
                "description": "AI note summaries. While not allowed, no new note gets a summary and existing summaries are withheld from note responses. Speech-to-text on notes is unaffected",
                "properties": {
                  "allow": {
                    "type": "boolean",
                    "description": "Whether AI note summaries are allowed for this business (e.g., true, false)"
                  }
                },
                "required": ["allow"]
              },
              "opted_in": {
                "type": "object",
                "description": "Whether the business has opted in to AI. A business with no stored record is treated as not opted in until it explicitly opts in",
                "properties": {
                  "allow": {
                    "type": "boolean",
                    "description": "Whether the business has opted in to AI (e.g., false, true)"
                  }
                },
                "required": ["allow"]
              },
              "client_agent": {
                "type": "object",
                "description": "The Client Communication switch in Settings > BizAI. While not allowed, the AI Client Agent does not run for the business, its existing recommendations are not listed in Pulse or on the client card, and no new reply suggestions are written to the composer. Recommendations are hidden, not deleted, and appear again once allowed",
                "properties": {
                  "allow": {
                    "type": "boolean",
                    "description": "Whether the AI Client Agent runs for this business (e.g., true, false)"
                  }
                },
                "required": ["allow"]
              },
              "pulse_client_agent": {
                "type": "object",
                "description": "Whether the business is opted in to Pulse and the AI Client Agent. While not allowed, Pulse is hidden, the Client Agent does not run, and the Client Communication setting is not shown. Set by the business's partner or by vcita, never by the business itself: a Staff token that sends this key is rejected with HTTP 403. Available for **Directory and Application tokens** only",
                "properties": {
                  "allow": {
                    "type": "boolean",
                    "description": "Whether the business is opted in to Pulse and the AI Client Agent (e.g., true, false)"
                  }
                },
                "required": ["allow"]
              }
            }
          }
        },
        "required": ["settings"],
        "example": {
          "settings": {
            "note_summary": {
              "allow": false
            }
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Provide a valid bearer token in the Authorization header. Example: 'Authorization: Bearer {app_token}'"
      }
    }
  }
}
